<script src="../assets/seismic.js"></script>
<script src="../assets/attributes.js"></script>
<script>
(function () {
  'use strict';

  const DEF = {
    amp: 22, len: 90, throw: 18, f: 30, snr: 0, spacing: 25,
    half: 2, khalf: 5, pmax: 5, np: 41,
    units: 'ms', ticks: false, fault: true, px: 0.30, pt: 0.45,
  };
  let S = SEIS.readState(DEF);

  const $ = (id) => document.getElementById(id);
  const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
  const CRIMSON = '#841617', TEAL = '#0B7285', SLATE = '#5C6670', OCHRE = '#8A6D1F';

  const NX = 200, NT = 300, DT = 0.002, VEL = 3000;
  const XF = 0.62;                     // fault position, fraction across

  /* ------------------------------- model ------------------------------- */

  // vertical shift of the reflectors at trace ix, in samples
  function shiftAt(ix) {
    const fold = S.amp === 0 ? 0 : (S.amp / (DT * 1000)) * Math.sin(2 * Math.PI * ix / S.len);
    const thr = ix > XF * NX ? (S.throw / (DT * 1000)) : 0;
    return fold + thr;
  }
  // true dip in samples per trace: the derivative of the fold. The fault is a
  // step, so it has no dip of its own — which is the point.
  function trueDip(ix) {
    if (S.amp === 0 || S.len === 0) return 0;
    return (S.amp / (DT * 1000)) * (2 * Math.PI / S.len) * Math.cos(2 * Math.PI * ix / S.len);
  }

  let CACHE = {};

  function buildSection() {
    const wav = SEIS.makeWavelet({ type: 'ricker', f: S.f });
    const rnd = SEIS.mulberry32(11);
    // reflectors well beyond the panel, so a steep dip cannot empty it
    const refl = [];
    for (let t = -900; t < NT + 900; t += 38) {
      refl.push({ it: t, r: (rnd() < 0.5 ? -1 : 1) * (0.06 + rnd() * 0.08) });
    }
    const fld = new Float32Array(NX * NT);
    for (let ix = 0; ix < NX; ix++) {
      const sh = shiftAt(ix);
      const sp = refl.map((R) => ({ t: (R.it + sh) * DT, r: R.r }));
      fld.set(SEIS.traceFromSpikes(sp, 0, DT, NT, wav), ix * NT);
    }
    if (S.snr > 0) {
      const nz = SEIS.bandLimitedNoise(NX, NT, DT, wav, 99, 2);
      const amp = 0.10 / S.snr;
      for (let i = 0; i < fld.length; i++) fld[i] += amp * nz[i];
    }
    return fld;
  }

  function scanOpts() {
    return { half: S.half, kHalf: S.khalf, pMax: S.pmax, nP: S.np };
  }

  function compute() {
    const fld = buildSection();
    const grid = ATTR.dipField(fld, NX, NT, Object.assign({ decX: 3, decT: 4 }, scanOpts()));
    // error against truth, away from the fault where truth is undefined
    let ss = 0, n = 0;
    for (let a = 0; a < grid.gx; a++) {
      const ix = a * grid.decX;
      if (Math.abs(ix - XF * NX) < 6) continue;
      for (let b = 0; b < grid.gt; b++) {
        const e = grid.p[a * grid.gt + b] - trueDip(ix);
        ss += e * e; n++;
      }
    }
    // Colour scale set by the dip actually present, not by the width of the
    // search fan. Tying it to pMax means widening the fan washes the display
    // out even though the structure has not changed.
    let dmax = 1e-3;
    for (let ix = 0; ix < NX; ix++) dmax = Math.max(dmax, Math.abs(trueDip(ix)));
    for (let i = 0; i < grid.p.length; i++) dmax = Math.max(dmax, Math.abs(grid.p[i]) * 0.6);
    CACHE = { fld, grid, rms: n ? Math.sqrt(ss / n) : 0, dmax: dmax * 1.15 };
  }

  /* ------------------------------- units ------------------------------- */

  function fmtDip(p) {
    if (S.units === 'samp') return p.toFixed(2) + ' samp/tr';
    if (S.units === 'deg') return ATTR.dipToDegrees(p, DT, S.spacing, VEL).toFixed(1) + '\u00b0';
    return ATTR.dipToMsPerTrace(p, DT).toFixed(2) + ' ms/tr';
  }
  const dipUnitLabel = () => S.units === 'samp' ? 'samples/trace'
    : S.units === 'deg' ? 'degrees' : 'ms/trace';

  /* ------------------------------- layout ------------------------------ */

  function layout(sel) {
    const box = $(sel).closest('.plot');
    const W = Math.max(300, box.clientWidth - 28);
    const stacked = W < 720;
    return { stacked, each: stacked ? W : Math.floor((W - 10) / 2) };
  }

  /* ------------------------------ drawing ------------------------------ */

  function drawSection(L) {
    const w = L.each, h = clamp(Math.round(w * 0.72), 260, 380);
    const ctx = SEIS.fitCanvas($('secCanvas'), w, h);
    ctx.clearRect(0, 0, w, h);
    const m = { l: 54, r: 12, t: 10, b: 42 };
    const rect = { x: m.l, y: m.t, w: w - m.l - m.r, h: h - m.t - m.b };
    const { fld, grid } = CACHE;

    let peak = 1e-6;
    for (let i = 0; i < fld.length; i++) peak = Math.max(peak, Math.abs(fld[i]));
    SEIS.drawVarDensity(ctx, fld, NX, NT, rect, { cmap: SEIS.COLORMAPS.gray, clip: peak * 0.85 });

    // Short bars drawn along the estimated slope. A dip of p samples per trace
    // means p samples down for every trace across, so the bar's screen slope is
    // that ratio scaled by the pixels-per-trace and pixels-per-sample of the
    // panel.
    if (S.ticks) {
      const sx = rect.w / NX, sy = rect.h / NT, halfBar = 5.5;
      ctx.save();
      ctx.beginPath(); ctx.rect(rect.x, rect.y, rect.w, rect.h); ctx.clip();
      ctx.strokeStyle = 'rgba(196,60,45,.95)'; ctx.lineWidth = 1.8;
      for (let ix = 8; ix < NX; ix += 14) {
        for (let it = 20; it < NT; it += 26) {
          const p = ATTR.sampleGrid(grid, grid.p, ix, it);
          const x = rect.x + ix * sx, y = rect.y + it * sy;
          const ex = halfBar * sx, ey = p * halfBar * sy;
          ctx.beginPath();
          ctx.moveTo(x - ex, y - ey); ctx.lineTo(x + ex, y + ey); ctx.stroke();
        }
      }
      ctx.restore();
    }

    if (S.fault && S.throw > 0) {
      const x = rect.x + XF * rect.w;
      SEIS.dashedLine(ctx, x, rect.y, x, rect.y + rect.h, OCHRE, [5, 4], 1.6);
      SEIS.tag(ctx, x + 4, rect.y + 11, 'fault', OCHRE);
    }

    const cx = rect.x + S.px * rect.w, cy = rect.y + S.pt * rect.h;
    ctx.save();
    ctx.strokeStyle = CRIMSON; ctx.lineWidth = 1.8;
    ctx.beginPath(); ctx.arc(cx, cy, 5, 0, 6.284); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(cx - 9, cy); ctx.lineTo(cx + 9, cy); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(cx, cy - 9); ctx.lineTo(cx, cy + 9); ctx.stroke();
    ctx.restore();

    SEIS.frame(ctx, rect);
    SEIS.axisBottom(ctx, rect, 0, NX, 'Trace', (v) => v.toFixed(0), { ticks: 4 });
    SEIS.axisLeft(ctx, rect, 0, NT * DT * 1000, 'Two-way time (ms)', (v) => v.toFixed(0));
    CACHE.secRect = rect;
  }

  function drawScan(L) {
    const w = L.each, h = clamp(Math.round(w * 0.72), 260, 380);
    const ctx = SEIS.fitCanvas($('scanCanvas'), w, h);
    ctx.clearRect(0, 0, w, h);
    const m = { l: 58, r: 14, t: 10, b: 42 };
    const rect = { x: m.l, y: m.t, w: w - m.l - m.r, h: h - m.t - m.b };
    ctx.fillStyle = '#fff'; ctx.fillRect(rect.x, rect.y, rect.w, rect.h);

    const ix = Math.round(S.px * NX), it = Math.round(S.pt * NT);
    const r = ATTR.dipScan(CACHE.fld, NX, NT, ix, it, scanOpts());
    CACHE.scan = r;

    const xOf = (p) => rect.x + ((p + S.pmax) / (2 * S.pmax)) * rect.w;
    const yOf = (s) => rect.y + rect.h - s * rect.h * 0.92;

    // every candidate that was tried, as a tick along the bottom
    ctx.save();
    ctx.strokeStyle = 'rgba(92,102,112,.35)'; ctx.lineWidth = 1;
    for (let i = 0; i < S.np; i++) {
      const p = -S.pmax + (2 * S.pmax * i) / (S.np - 1);
      ctx.beginPath();
      ctx.moveTo(xOf(p), rect.y + rect.h);
      ctx.lineTo(xOf(p), rect.y + rect.h - 5);
      ctx.stroke();
    }
    ctx.restore();

    ctx.save();
    ctx.strokeStyle = CRIMSON; ctx.lineWidth = 2.4;
    ctx.beginPath();
    for (let i = 0; i < S.np; i++) {
      const p = -S.pmax + (2 * S.pmax * i) / (S.np - 1);
      const x = xOf(p), y = yOf(r.curve[i]);
      i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
    }
    ctx.stroke();
    for (let i = 0; i < S.np; i++) {
      const p = -S.pmax + (2 * S.pmax * i) / (S.np - 1);
      ctx.fillStyle = 'rgba(132,22,23,.55)';
      ctx.beginPath(); ctx.arc(xOf(p), yOf(r.curve[i]), 2.1, 0, 6.284); ctx.fill();
    }
    ctx.restore();

    // the winner, and the truth
    SEIS.dashedLine(ctx, xOf(r.p), rect.y, xOf(r.p), rect.y + rect.h, CRIMSON, [5, 4], 1.8);
    SEIS.tag(ctx, xOf(r.p) + 4, rect.y + 11, 'winner', CRIMSON);
    const tp = trueDip(ix);
    if (Math.abs(tp) <= S.pmax) {
      SEIS.dashedLine(ctx, xOf(tp), rect.y, xOf(tp), rect.y + rect.h, TEAL, [3, 3], 1.6);
      SEIS.tag(ctx, xOf(tp) + 4, rect.y + rect.h - 12, 'true dip', TEAL);
    }

    SEIS.frame(ctx, rect);
    const lo = S.units === 'samp' ? -S.pmax
      : S.units === 'deg' ? ATTR.dipToDegrees(-S.pmax, DT, S.spacing, VEL)
      : ATTR.dipToMsPerTrace(-S.pmax, DT);
    SEIS.axisBottom(ctx, rect, lo, -lo, 'Candidate dip (' + dipUnitLabel() + ')',
                    (v) => v.toFixed(S.units === 'samp' ? 1 : 0), { ticks: 4 });
    SEIS.axisLeft(ctx, rect, 0, 1 / 0.92, 'Semblance', (v) => v.toFixed(1), { flip: true });
  }

  function drawDipMap(id, which, L) {
    const w = L.each, h = clamp(Math.round(w * 0.62), 220, 320);
    const ctx = SEIS.fitCanvas($(id), w, h);
    ctx.clearRect(0, 0, w, h);
    const m = { l: 54, r: 12, t: 34, b: 42 };
    const rect = { x: m.l, y: m.t, w: w - m.l - m.r, h: h - m.t - m.b };
    const { grid } = CACHE;
    const scale = CACHE.dmax;

    const off = document.createElement('canvas');
    off.width = NX; off.height = NT;
    const octx = off.getContext('2d');
    const img = octx.createImageData(NX, NT);
    for (let it = 0; it < NT; it++) {
      for (let ix = 0; ix < NX; ix++) {
        const p = which === 'true' ? trueDip(ix) : ATTR.sampleGrid(grid, grid.p, ix, it);
        const c = ATTR.MAPS.dip(p / scale);
        const q = it * NX + ix;
        img.data[q * 4] = c[0]; img.data[q * 4 + 1] = c[1];
        img.data[q * 4 + 2] = c[2]; img.data[q * 4 + 3] = 255;
      }
    }
    octx.putImageData(img, 0, 0);
    ctx.save();
    ctx.imageSmoothingEnabled = true; ctx.imageSmoothingQuality = 'high';
    ctx.drawImage(off, rect.x, rect.y, rect.w, rect.h);
    ctx.restore();

    // colour bar
    const bw = Math.min(rect.w, 170), by = rect.y - 26;
    for (let i = 0; i < bw; i++) {
      const c = ATTR.MAPS.dip((i / (bw - 1)) * 2 - 1);
      ctx.fillStyle = 'rgb(' + c[0] + ',' + c[1] + ',' + c[2] + ')';
      ctx.fillRect(rect.x + i, by, 1.3, 9);
    }
    ctx.save();
    ctx.strokeStyle = 'rgba(22,25,28,.45)'; ctx.lineWidth = 1;
    ctx.strokeRect(rect.x + 0.5, by + 0.5, bw, 9);
    ctx.font = '9.5px "IBM Plex Mono", monospace'; ctx.fillStyle = SLATE;
    ctx.textBaseline = 'top'; ctx.textAlign = 'left';
    ctx.fillText(fmtDip(-scale), rect.x, by + 11);
    ctx.textAlign = 'right';
    ctx.fillText(fmtDip(scale), rect.x + bw, by + 11);
    ctx.restore();

    if (S.fault && S.throw > 0) {
      const x = rect.x + XF * rect.w;
      SEIS.dashedLine(ctx, x, rect.y, x, rect.y + rect.h, OCHRE, [4, 3], 1.4);
    }
    const cx = rect.x + S.px * rect.w, cy = rect.y + S.pt * rect.h;
    ctx.save();
    ctx.strokeStyle = CRIMSON; ctx.lineWidth = 1.6;
    ctx.beginPath(); ctx.arc(cx, cy, 4, 0, 6.284); ctx.stroke();
    ctx.restore();

    SEIS.frame(ctx, rect);
    SEIS.axisBottom(ctx, rect, 0, NX, 'Trace', (v) => v.toFixed(0), { ticks: 4 });
    SEIS.axisLeft(ctx, rect, 0, NT * DT * 1000, '', (v) => v.toFixed(0));
  }

  /* ------------------------------ readouts ----------------------------- */

  function update() {
    const ix = Math.round(S.px * NX);
    const r = CACHE.scan, tp = trueDip(ix);
    const nearFault = S.throw > 0 && Math.abs(S.px - XF) < 0.02;

    $('rTrue').textContent = nearFault ? 'undefined — on the fault' : fmtDip(tp);
    $('rEst').textContent = fmtDip(r.p);
    $('rErr').textContent = nearFault ? '—' : fmtDip(r.p - tp);
    $('rSem').textContent = r.sem.toFixed(3);
    $('rAper').textContent = (2 * S.half + 1) + ' traces \u00d7 ' +
      ((2 * S.khalf + 1) * DT * 1000).toFixed(0) + ' ms';
    const step = (2 * S.pmax) / (S.np - 1);
    $('rStep').textContent = fmtDip(step) + ' between candidates';
    $('rRms').textContent = fmtDip(CACHE.rms) + ' rms';

    const clipped = Math.abs(r.p) > S.pmax * 0.97;
    $('rVerdict').textContent = nearFault
      ? 'On the fault, no candidate dip can align the traces, so semblance collapses and the dip estimate is meaningless. That collapse is what a coherence attribute maps.'
      : clipped
        ? 'The scan has hit the edge of its fan — the true dip is steeper than the widest dip searched, so this estimate is a limit, not a measurement.'
        : r.sem < 0.55
          ? 'Semblance is low, so the winning dip is the best of a bad set. Expect this estimate to be noisy, and remember curvature will differentiate it.'
          : 'A clean single peak, and the estimate sits on the true dip. This is what the rest of the attributes are built on.';

    $('topLegend').innerHTML =
      '<span><i style="border-color:' + CRIMSON + '"></i>semblance at each candidate</span>' +
      '<span><i style="border-color:' + CRIMSON + ';border-top-style:dashed"></i>winning dip</span>' +
      '<span><i style="border-color:' + TEAL + ';border-top-style:dashed"></i>true dip</span>' +
      (S.throw > 0 && S.fault ? '<span><i style="border-color:' + OCHRE + ';border-top-style:dashed"></i>fault</span>' : '');
    $('dipLegend').innerHTML =
      '<span>Dip shown in ' + dipUnitLabel() + '; brown and blue are opposite directions, pale is flat.</span>';
  }

  /* ------------------------------ plumbing ----------------------------- */

  function render() {
    const L1 = layout('secCanvas');
    $('topRow').querySelectorAll('.panel-col').forEach((c) => { c.style.width = L1.each + 'px'; });
    drawSection(L1); drawScan(L1);
    const L2 = layout('trueCanvas');
    $('dipRow').querySelectorAll('.panel-col').forEach((c) => { c.style.width = L2.each + 'px'; });
    drawDipMap('trueCanvas', 'true', L2);
    drawDipMap('estCanvas', 'est', L2);
    update();
  }
  function refresh() { compute(); render(); SEIS.writeState(S, DEF); }

  function syncLabels() {
    $('ampV').textContent = S.amp + ' ms';
    $('lenV').textContent = S.len + ' traces';
    $('throwV').textContent = S.throw + ' ms';
    $('freqV').textContent = S.f + ' Hz';
    $('snrV').textContent = S.snr <= 0 ? 'clean' : S.snr.toFixed(1) + ' : 1';
    $('spacingV').textContent = S.spacing + ' m';
    $('halfV').textContent = S.half + '  (' + (2 * S.half + 1) + ' traces)';
    $('khalfV').textContent = S.khalf + '  (' + ((2 * S.khalf + 1) * DT * 1000).toFixed(0) + ' ms)';
    $('pmaxV').textContent = '\u00b1' + S.pmax.toFixed(1) + ' samples/trace';
    $('npV').textContent = S.np;
  }
  function pushToInputs() {
    ['amp', 'len', 'throw', 'half', 'khalf', 'pmax', 'np', 'spacing'].forEach((k) => {
      const el = $(k === 'throw' ? 'throw' : k); if (el) el.value = S[k];
    });
    $('freq').value = S.f; $('snr').value = S.snr;
    $('units').value = S.units; $('ticks').checked = S.ticks; $('showFault').checked = S.fault;
  }
  function bump() { syncLabels(); refresh(); }

  const slide = (id, key) => $(id).addEventListener('input', () => {
    S[key] = parseFloat($(id).value); bump();
  });
  slide('amp', 'amp'); slide('len', 'len'); slide('throw', 'throw');
  slide('freq', 'f'); slide('snr', 'snr'); slide('spacing', 'spacing');
  slide('half', 'half'); slide('khalf', 'khalf'); slide('pmax', 'pmax'); slide('np', 'np');

  $('units').addEventListener('change', () => { S.units = $('units').value; syncLabels(); render(); });
  $('ticks').addEventListener('change', () => { S.ticks = $('ticks').checked; render(); });
  $('showFault').addEventListener('change', () => { S.fault = $('showFault').checked; render(); });
  $('resetBtn').addEventListener('click', () => { S = Object.assign({}, DEF); pushToInputs(); bump(); });
  $('copyBtn').addEventListener('click', (e) => SEIS.copyLink(e.currentTarget));

  (function attachPick() {
    const c = $('secCanvas');
    const go = (ev) => {
      const r = c.getBoundingClientRect(), q = CACHE.secRect;
      if (!q) return;
      S.px = clamp((ev.clientX - r.left - q.x) / q.w, 0.03, 0.97);
      S.pt = clamp((ev.clientY - r.top - q.y) / q.h, 0.05, 0.95);
      render(); SEIS.writeState(S, DEF);
    };
    let down = false;
    c.addEventListener('pointerdown', (e) => { down = true; c.setPointerCapture(e.pointerId); e.preventDefault(); go(e); });
    c.addEventListener('pointermove', (e) => { if (down) go(e); });
    c.addEventListener('pointerup', () => { down = false; });
    c.addEventListener('pointercancel', () => { down = false; });
  })();

  let rt;
  window.addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(render, 120); });

  pushToInputs(); syncLabels(); refresh();
  document.fonts && document.fonts.ready.then(render);
})();
</script>
</body>
</html>
